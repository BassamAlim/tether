<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Import is a picker, not a sync: requested when you tap the button, never at launch. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- The weekly nudge. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Naming a pasted Google Maps link, and nothing else: see PlacesRepository. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- BiometricPrompt on cold start, with device credential as the fallback. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Package visibility: without this, setPackage("com.whatsapp") can never resolve. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tether">
        <activity
            android:name=".core.Activity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Tether"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".core.nudge.NudgeActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="bassamalim.tether.SNOOZE_NUDGE" />
            </intent-filter>
        </receiver>

        <!-- WorkManager is configured by App (it supplies Hilt's worker factory). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
